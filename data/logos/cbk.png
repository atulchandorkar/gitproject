        $(document).ready(function () {            
	
	$(".flexy-menu").flexymenu({
		speed: 400, 
		indicator: false});
		
	$('#news').bxSlider({
    auto: true,
    controls: false,
	pager:true,
	speed:1000,
	pause:6800,
	mode:'vertical',
	pagerSelector:'#newpager'
  });
  
  
  var slider = $('#banner').bxSlider({
    auto: true,
	pager:false,
	speed:1000,
	pause:4000,
	mode:'fade',
	  onSlideAfter: function() {
        slider.stopAuto();
        slider.startAuto();
        }	
  });
  
  $('#caption').bxSlider({
    auto: false,
    controls: true,
	pager:false,
	speed:1500,
	pause:6200,
	//mode:'fade',
	pagerSelector:'#newpager'
  });
 
 
 $(".btn-slide").click(function(){
