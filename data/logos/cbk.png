<script type="text/javascript">

    function initialize() {
        var mapOptions = {
            center: new google.maps.LatLng("29.3697", "47.9783"),
            zoom: 10,
            mapTypeId: google.maps.MapTypeId.ROADMAP
        };
        var infoWindow = new google.maps.InfoWindow();
        var map = new google.maps.Map(document.getElementById("dvMap"), mapOptions);

        for (i = 0; i < markerList.length; i++) {
            var data = markerList[i];
            var myLatlng = new google.maps.LatLng(data.lat, data.lng);

            var icon = {
                url: '/media/4372fd08-4a06-4519-a803-2f079e69fecf/QQ2PmQ/Media Library/Icons-Branch.png', // url
                scaledSize: new google.maps.Size(30, 37), // scaled size
                origin: new google.maps.Point(0, 0), // origin
                anchor: new google.maps.Point(0, 0) // anchor
            };


            var marker = new google.maps.Marker({
                position: myLatlng,
                map: map,
                icon: googlemarkerimg(data.icon), //data.icon,
                //icon:   icon,
                title: data.title,
                animation: google.maps.Animation.DROP
            });

            (function (marker, data) {
                google.maps.event.addListener(marker, "click", function (e) {
                    infoWindow.setContent("<div style=\"width:200px;height:150px\"><h3>" + data.title + "</h3><br/>" + data.description + "</div>");
                    infoWindow.open(map, marker);
                });
            })(marker, data);
        }

        // for fixing resizing the map for the second time issue
        google.maps.event.addListenerOnce(map, 'idle', function () {
            google.maps.event.trigger(map, 'resize');
            map.setCenter(new google.maps.LatLng('29.3697', '47.9783'));
        });

        var legend = document.getElementById('legend');
        map.controls[google.maps.ControlPosition.RIGHT_BOTTOM].push(legend);
    }

    function googlemarkerimg(imgpath) {
        var newIcon = { url: location.protocol + '//'+ location.host + '/' + imgpath, scaledSize: new google.maps.Size(30, 37) };

        return newIcon;
    }
    //google.maps.event.addDomListener(window, 'load', initialize);
</script>


