<link type="text/xml" rel="alternate" href="/_vti_bin/spsdisco.aspx" /><span id="DeltaSPWebPartManager">
                                                
                                            </span><meta charset="utf-8" /><meta http-equiv="X-UA-Compatible" content="IE=edge" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta http-equiv="X-UA-Compatible" content="IE=edge" /><meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, minimum-scale=1.0, maximum-scale=3.0" /><link href="/_catalogs/masterpage/css/GlobalFontEN.css" /><link href="/_catalogs/masterpage/css/style.css" rel="stylesheet" /><link href="/_catalogs/masterpage/css/dropdowns.css" rel="stylesheet" />
                                            <!-- Bootstrap -->
                                            <link href="/_catalogs/masterpage/css/bootstrap.css" rel="stylesheet" /><link href="/_catalogs/masterpage/css/font-awesome.min.css" rel="stylesheet" />
                                            <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
                                            <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->


                                            <script type="text/javascript"
                                                src='/_catalogs/masterpage/js/jquery-3.7.1-0.min.js'></script>
                                            <script src="/_catalogs/masterpage/js/bootstrap.js">//<![CDATA[
                                                //]]></script>



                                            <script type="text/javascript" src="/_catalogs/masterpage/js/dropdowns.js">//<![CDATA[
                                                //]]></script>
                                            <script type="text/javascript" src="/_catalogs/masterpage/js/master.js">//<![CDATA[
                                                //]]></script>
                                            <script type="text/javascript"
                                                src="/_catalogs/masterpage/js/RetailProducts.js"></script>
                                            <script>


                                                var segment = "";
                                                var category = "";
                                                var subcategory = "";

                                                function GetPreviousPageName() {

                                                    // getting last page url

                                                    var lastVisitedPage = '';
                                                    var pagesRetrievedData = sessionStorage.getItem('pageInfo');

                                                    if (pagesRetrievedData) {
                                                        var pagesArray = JSON.parse(pagesRetrievedData);

                                                        var lastPageObj = pagesArray.find(m => m.PageURL === document.referrer);

                                                        if (lastPageObj != null) {
                                                            lastVisitedPage = lastPageObj.PageTitle;
                                                        }
                                                    }

                                                    return lastVisitedPage;

                                                }
                                                function replaceOMR(root) {
                                                    root = root || document.body;

                                                    var walker = document.createTreeWalker(
                                                        root,
                                                        NodeFilter.SHOW_TEXT,
                                                        null,
                                                        false
                                                    );

                                                    var node;

                                                    while ((node = walker.nextNode())) {
                                                        var text = node.nodeValue;

                                                        if (text.includes("OMR") ||
                                                            text.includes("rial Omani") ||
                                                            text.includes("Rials Omani") ||
                                                            text.includes("RO") ||
                                                            text.includes("rials Omani") ||
                                                            text.includes("Omani rial") ||
                                                            text.includes("Omani Riyals") ||
                                                            text.includes("Omani rials") ||
                                                            text.includes("Rial Omani") ||
                                                            text.includes("Omani Rial") ||
                                                            text.includes("Omani Rials") ||
                                                            text.includes("Riyal Omani")) {
                                                            node.nodeValue = text
                                                                .replace(/\bOMR\b/g, "¤")
                                                                .replace(/\brial Omani\b/g, "¤")
                                                                .replace(/\bRO\b/g, "¤")
                                                                .replace(/\bRials Omani\b/g, "¤")
                                                                .replace(/\brials Omani\b/g, "¤")
                                                                .replace(/\bOmani rial\b/g, "¤")
                                                                .replace(/\bOmani Riyals\b/g, "¤")
                                                                .replace(/\bOmani rials\b/g, "¤")
                                                                .replace(/\bRial Omani \b/g, "¤")
                                                                .replace(/\bOmani Rial\b/g, "¤")
                                                                .replace(/\bOmani Rials\b/g, "¤")
                                                                .replace(/\bRiyal Omani\b/g, "¤");

                                                        }
                                                    }
                                                }
                                                function replaceFontFamily(root) {
                                                    root = root || document.body;

                                                    root.querySelectorAll('[style]').forEach(function (el) {
                                                        var fontFamily = el.style.fontFamily;
                                                        if (!fontFamily) return;
                                                        fontFamily = fontFamily.toLowerCase();
                                                        if (fontFamily.includes("precioussansmedium") || fontFamily.includes("tajawalregular")) {

                                                            el.style.fontFamily = "BankMuscatSans-Regular";
                                                        }
                                                    });
                                                }

                                                // Initial run
                                                replaceFontFamily();
                                                replaceOMR();
                                                // Watch for new content
                                                const observer = new MutationObserver(function (mutations) {
                                                    mutations.forEach(function (mutation) {
                                                        mutation.addedNodes.forEach(function (node) {
                                                            if (node.nodeType === 1) {
                                                                replaceFontFamily(node);
                                                                replaceOMR(node);

                                                            }
                                                        });
                                                    });
                                                });

                                                observer.observe(document.body, {
                                                    childList: true,
                                                    subtree: true
                                                });


                                                $(document).ready(function () {


                                                    // setting current page in localstorage

                                                    var retrievedData = sessionStorage.getItem('pageInfo');
                                                    if (retrievedData) {
                                                        var pageInfoArray = JSON.parse(retrievedData);

                                                        pageInfoArray.push({ PageURL: window.location.href, PageTitle: document.title });
                                                        sessionStorage.setItem('pageInfo', JSON.stringify(pageInfoArray));


                                                    } else {
                                                        var pageInfoArray = [
                                                            { PageURL: window.location.href, PageTitle: document.title }
                                                        ];

                                                        sessionStorage.setItem('pageInfo', JSON.stringify(pageInfoArray));
                                                    }


                                                    //  Get current page url using JavaScript
                                                    var currentPageUrl = "";
                                                    if (typeof this.href === "undefined") {
                                                        currentPageUrl = document.location.toString().toLowerCase();
                                                    }
                                                    else {
                                                        currentPageUrl = this.href.toString().toLowerCase();
                                                    }
                                                    var sliteddata = currentPageUrl.split("/");


                                                    if (sliteddata[4] == "premierbanking" || sliteddata[4] == "accounts" || sliteddata[4] == "loans" || sliteddata[4] == "bm-cards" || sliteddata[4] == "Bancassurance" || sliteddata[4] == "expatservices" || sliteddata[4] == "deposit-locker") {
                                                        segment = "personals";

                                                        if (sliteddata[4] == "expatservices" || sliteddata[4] == "deposit-locker") {
                                                            category = '';
                                                        }
                                                        else {
                                                            category = sliteddata[4];
                                                        }

                                                        subcategory = '';
                                                    }
                                                    else if (sliteddata[4] == "najahi" || sliteddata[4] == "sme" || sliteddata[4] == "corporatebanking" || sliteddata[4] == "investmenbanking" || sliteddata[4] == "treasury" || sliteddata[4] == "businessinsurance" || sliteddata[4] == "corporatecards") {

                                                        segment = "business";

                                                        if (sliteddata[4] == "corporatebanking" || sliteddata[4] == "businessinsurance") {
                                                            category = sliteddata[4];
                                                        }

                                                        subcategory = '';

                                                    }

                                                    else if (sliteddata[4] == "investments") {
                                                        segment = "investments";
                                                        category = "";
                                                        subcategory = "";
                                                    }

                                                    else if (sliteddata[4] == "pages") {
                                                        if (sliteddata[5] == "mutualfunds.aspx") {
                                                            segment = "investments";
                                                            category = "";
                                                            subcategory = "";

                                                        }
                                                        else if (sliteddata[5] == "default.aspx") {
                                                            segment = "Home";
                                                            category = "";
                                                            subcategory = "";

                                                        }
                                                        else if (sliteddata[5] == "eapplication.aspx") {
                                                            segment = "business";
                                                            category = "";
                                                            subcategory = "";

                                                        }
                                                        else {
                                                            segment = sliteddata[4];
                                                            category = '';
                                                            subcategory = '';

                                                        }
                                                    }

                                                    else if (sliteddata[4] == "bankingchannels") {
                                                        segment = "bankingchannels";
                                                        category = '';
                                                        subcategory = '';

                                                    }
                                                    else {
                                                        segment = sliteddata[4];
                                                        category = '';
                                                        subcategory = '';

                                                    }


                                                    //console.log("Language: " + sliteddata[3] + " Segment: " + segment + " Category: " + category  + " SubCategory: " + subcategory);


                                                    var dataLayer = window.dataLayer || [];
                                                    dataLayer.push({
                                                        'language': sliteddata[3],
                                                        'segment': segment,
                                                        'category': category,
                                                        'subCategory': subcategory,
                                                        'loginStatus': 'Guest',
                                                        'customerID': ''
                                                    });

                                                    $(".dropdowns").dropdowns();




                                                    var isMobile = false; //initiate as false
                                                    // device detection
                                                    if (/(android|bb\d+|meego).+mobile|avantgo|bada\/|blackberry|blazer|compal|elaine|fennec|hiptop|iemobile|ip(hone|od)|ipad|iris|kindle|Android|Silk|lge |maemo|midp|mmp|netfront|opera m(ob|in)i|palm( os)?|phone|p(ixi|re)\/|plucker|pocket|psp|series(4|6)0|symbian|treo|up\.(browser|link)|vodafone|wap|windows (ce|phone)|xda|xiino/i.test(navigator.userAgent)
                                                        || /1207|6310|6590|3gso|4thp|50[1-6]i|770s|802s|a wa|abac|ac(er|oo|s\-)|ai(ko|rn)|al(av|ca|co)|amoi|an(ex|ny|yw)|aptu|ar(ch|go)|as(te|us)|attw|au(di|\-m|r |s )|avan|be(ck|ll|nq)|bi(lb|rd)|bl(ac|az)|br(e|v)w|bumb|bw\-(n|u)|c55\/|capi|ccwa|cdm\-|cell|chtm|cldc|cmd\-|co(mp|nd)|craw|da(it|ll|ng)|dbte|dc\-s|devi|dica|dmob|do(c|p)o|ds(12|\-d)|el(49|ai)|em(l2|ul)|er(ic|k0)|esl8|ez([4-7]0|os|wa|ze)|fetc|fly(\-|_)|g1 u|g560|gene|gf\-5|g\-mo|go(\.w|od)|gr(ad|un)|haie|hcit|hd\-(m|p|t)|hei\-|hi(pt|ta)|hp( i|ip)|hs\-c|ht(c(\-| |_|a|g|p|s|t)|tp)|hu(aw|tc)|i\-(20|go|ma)|i230|iac( |\-|\/)|ibro|idea|ig01|ikom|im1k|inno|ipaq|iris|ja(t|v)a|jbro|jemu|jigs|kddi|keji|kgt( |\/)|klon|kpt |kwc\-|kyo(c|k)|le(no|xi)|lg( g|\/(k|l|u)|50|54|\-[a-w])|libw|lynx|m1\-w|m3ga|m50\/|ma(te|ui|xo)|mc(01|21|ca)|m\-cr|me(rc|ri)|mi(o8|oa|ts)|mmef|mo(01|02|bi|de|do|t(\-| |o|v)|zz)|mt(50|p1|v )|mwbp|mywa|n10[0-2]|n20[2-3]|n30(0|2)|n50(0|2|5)|n7(0(0|1)|10)|ne((c|m)\-|on|tf|wf|wg|wt)|nok(6|i)|nzph|o2im|op(ti|wv)|oran|owg1|p800|pan(a|d|t)|pdxg|pg(13|\-([1-8]|c))|phil|pire|pl(ay|uc)|pn\-2|po(ck|rt|se)|prox|psio|pt\-g|qa\-a|qc(07|12|21|32|60|\-[2-7]|i\-)|qtek|r380|r600|raks|rim9|ro(ve|zo)|s55\/|sa(ge|ma|mm|ms|ny|va)|sc(01|h\-|oo|p\-)|sdk\/|se(c(\-|0|1)|47|mc|nd|ri)|sgh\-|shar|sie(\-|m)|sk\-0|sl(45|id)|sm(al|ar|b3|it|t5)|so(ft|ny)|sp(01|h\-|v\-|v )|sy(01|mb)|t2(18|50)|t6(00|10|18)|ta(gt|lk)|tcl\-|tdg\-|tel(i|m)|tim\-|t\-mo|to(pl|sh)|ts(70|m\-|m3|m5)|tx\-9|up(\.b|g1|si)|utst|v400|v750|veri|vi(rg|te)|vk(40|5[0-3]|\-v)|vm40|voda|vulc|vx(52|53|60|61|70|80|81|83|85|98)|w3c(\-| )|webc|whit|wi(g |nc|nw)|wmlb|wonu|x700|yas\-|your|zeto|zte\-/i.test(navigator.userAgent.substr(0, 4))) {
