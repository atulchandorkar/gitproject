                                                    setTimeout(function () {

                                                        $('.nav > li > ul > li > ul > li a').click(function (e) {

                                                            e.preventDefault();

                                                            var headerLink = $(this)[0].href;
                                                            var headerSubCategory = $(this)[0].text;
                                                            var headerCategory = $($(this).parents()[2]).find('a')[0].text;
                                                            var headerSegment = $($(this).parents()[4]).find('a')[0].text;

                                                            PushDataGA('headerinteraction', headerLink, headerSegment, headerCategory, headerSubCategory);

                                                            location.href = e.currentTarget.href;

                                                        });


                                                        $('.nav > li > ul > li > a').click(function (e) {

                                                            e.preventDefault();

                                                            var headerLink = $(this)[0].href;
                                                            var headerSubCategory = '';
                                                            var headerCategory = $(this)[0].text;
                                                            var headerSegment = $($(this).parents()[2]).find('a')[0].text;

                                                            PushDataGA('headerinteraction', headerLink, headerSegment, headerCategory, headerSubCategory);

                                                            location.href = e.currentTarget.href;

                                                        });


                                                        $('.nav > li > a').click(function (e) {

                                                            e.preventDefault();

                                                            var headerLink = $(this)[0].href;
                                                            var headerSubCategory = '';
                                                            var headerCategory = '';
                                                            var headerSegment = $(this)[0].text;

                                                            PushDataGA('headerinteraction', headerLink, headerSegment, headerCategory, headerSubCategory);

                                                            location.href = e.currentTarget.href;

                                                        });


