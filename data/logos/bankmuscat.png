                                            <script>
                                                // Page Details Extraction Function  
                                                function getPageDetails() {
                                                    const pageTitle = document.title;
                                                    const previousPageTitle = sessionStorage.getItem('currentPageTitle') || 'direct';
                                                    const urlPath = window.location.pathname.split('/');
                                                    const pageCategory = urlPath[2] || '';
                                                    const pageSubCategory = urlPath[3] || '';

                                                    // Store the current page title in sessionStorage for the next page  
                                                    sessionStorage.setItem('currentPageTitle', pageTitle);

                                                    return {
                                                        pageTitle,
                                                        pageCategory,
                                                        pageSubCategory,
                                                        previousPageTitle
                                                    };
                                                }
                                                // Get Current Page Details  
                                                const { pageTitle, pageCategory, pageSubCategory, previousPageTitle } = getPageDetails();
                                                window.onload = function () {


                                                    // Enhanced Data Layer Push Function  
                                                    function pushToDataLayer(event, category, action, label, p_language, p_pagename, p_pagecategory, p_pagesubcategory, p_previouspagename, p_locationtype, p_location) {
                                                        window.dataLayer = window.dataLayer || [];
                                                        window.dataLayer.push({
                                                            event: event.toLowerCase(),
                                                            category: category ? category.toLowerCase() : null,
                                                            action: action ? action.toLowerCase() : null,
                                                            label: label ? label.toLowerCase() : null,
                                                            p_language: p_language.toLowerCase(),
                                                            p_pagename: p_pagename.toLowerCase(),
                                                            p_pagecategory: p_pagecategory.toLowerCase(),
                                                            p_pagesubcategory: p_pagesubcategory.toLowerCase(),
                                                            p_previouspagename: p_previouspagename.toLowerCase(),
                                                            p_locationtype: p_locationtype.toLowerCase(),
                                                            p_location: p_location.toLowerCase()
                                                        });
                                                    }
                                                    function pushToDataLayer2(event, p_language, p_pagename, p_pagecategory, p_pagesubcategory, p_previouspagename, p_customerid, p_subject, p_formname, p_leadid) {
                                                        window.dataLayer = window.dataLayer || [];
                                                        window.dataLayer.push({
                                                            event: event.toLowerCase(),
                                                            p_language: p_language.toLowerCase(),
                                                            p_pagename: p_pagename.toLowerCase(),
                                                            p_pagecategory: p_pagecategory.toLowerCase(),
                                                            p_pagesubcategory: p_pagesubcategory.toLowerCase(),
                                                            p_previouspagename: p_previouspagename.toLowerCase(),
                                                            p_customerid: p_customerid.toLowerCase(),
                                                            p_subject: p_subject.toLowerCase(),
                                                            p_formname: p_formname.toLowerCase(),
                                                            p_leadid: p_leadid.toLowerCase()
                                                        });
                                                    }





                                                    // Initial Page View Event  
                                                    pushToDataLayer('e_pageview', null, null, null, 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');


                                                    // Event Listeners Function  
                                                    function addEventListenersToButtons() {
                                                        // Locator Search

                                                        // Event Delegation - Fire only when BOTH values are selected
                                                        document.addEventListener('change', function (e) {

                                                            const typeSelect = document.getElementById('ddl-locator-type');
                                                            const locationSelect = document.getElementById('locations');

                                                            // Check if both dropdowns have values
                                                            if (typeSelect && locationSelect &&
                                                                typeSelect.value &&
                                                                locationSelect.value) {

                                                                pushToDataLayer(
                                                                    'e_locatorsearch',           // event
                                                                    'locator search',            // category
                                                                    'search button',             // action
                                                                    typeSelect.value,            // label → e.g. "CDM", "RetailBranch"
                                                                    'en',                        // p_language
                                                                    pageTitle,
                                                                    pageCategory,
                                                                    pageSubCategory,
                                                                    previousPageTitle,
                                                                    locationSelect.value         // p_location → selected branch/location
                                                                );
                                                            }
                                                        });
                                                        //Internet Banking Event
                                                        document.querySelectorAll('.internet-banking-btn').forEach(button => {
                                                            button.addEventListener('click', () => {
                                                                pushToDataLayer(
                                                                    'e_internetbanking',
                                                                    'header interaction',
                                                                    'button click',
                                                                    'internet banking',
                                                                    'en',
                                                                    pageTitle,
                                                                    pageCategory,
                                                                    pageSubCategory,
                                                                    previousPageTitle,
                                                                    '',
                                                                    ''
                                                                );
                                                            });
                                                        });
                                                        // Track PDF Download Click + Get Label from H1
                                                        document.addEventListener('click', function (e) {

                                                            // Find if clicked element is one of the channel links
                                                            const channelLink = e.target.closest('.activity-item');


                                                            // === OFFERS TRACKING ===
                                                            const offerLink = e.target.closest('a[id^="a-"]');

                                                            // === FORM DOWNLOAD / LINK TRACKING ===
                                                            const formLink = e.target.closest('a[href$=".pdf"]') ||
                                                                e.target.closest('a[target="_blank"]');

                                                            // Check if clicked element is the download icon
                                                            if (e.target.classList.contains('download-svg') ||
                                                                e.target.closest('img[title="Save as pdf"]')) {

                                                                // Get the H1 text (e.g., "Current Account")
                                                                let label = 'current account'; // fallback

                                                                const h1 = document.querySelector('h1');
                                                                if (h1) {
                                                                    // Remove the span content (the download icon) and get clean text
                                                                    label = h1.cloneNode(true);
                                                                    const span = label.querySelector('span');
                                                                    if (span) span.remove();
                                                                    label = label.textContent.trim();
                                                                }

                                                                pushToDataLayer(
                                                                    'e_download',                    // event
                                                                    'user interaction',              // category
                                                                    'button click',                  // action
                                                                    'label',               // label
                                                                    'en',                            // p_language
                                                                    pageTitle,                      // p_pagename
                                                                    pageCategory,               // p_pagecategory
                                                                    pageSubCategory,               // p_pagesubcategory
                                                                    previousPageTitle,
                                                                    '',
                                                                    ''                      // p_previouspagename
                                                                );
                                                            }
                                                            else if (channelLink) {
                                                                // Get the label from h4 (e.g., "CDM", "ATM", "Mobile Banking", etc.)
                                                                let label = 'unknown channel';

                                                                const h4 = channelLink.querySelector('h4');
                                                                if (h4) {
                                                                    // Get clean text (remove extra spans if any)
                                                                    const temp = h4.cloneNode(true);
                                                                    label = temp.textContent.trim();
                                                                }

                                                                // Optional: Use ID-based mapping for cleaner labels (recommended)
                                                                const id = channelLink.id;
                                                                const labelMap = {
                                                                    'a-1': 'atm',
                                                                    'a-2': 'cdm',
                                                                    'a-3': 'ffm',
                                                                    'a-4': 'contact center',
                                                                    'a-5': 'corporate online banking',
                                                                    'a-6': 'personal online banking',
                                                                    'a-7': 'mobile banking',
                                                                    'a-8': 'bm wallet',
                                                                    'a-9': 'self service kiosk',
                                                                    'a-10': 'business cash deposit machine',
                                                                    'a-11': 'statement printer kiosk',
                                                                    'a-12': 'bm remit',
                                                                    'a-13': 'soft token'
                                                                };

                                                                label = labelMap[id] || label.toLowerCase();

                                                                pushToDataLayer(
                                                                    'e_channels',                    // event
                                                                    'user interaction',              // category
                                                                    'button click',                  // action
                                                                    label,                           // dynamic label
                                                                    'en',                            // p_language
                                                                    pageTitle,                      // p_pagename
                                                                    pageCategory,               // p_pagecategory
                                                                    pageSubCategory,               // p_pagesubcategory
                                                                    previousPageTitle,
                                                                    '',
                                                                    ''
                                                                );
                                                            }
                                                            else if (offerLink) {

                                                                // Get label from h4 text
                                                                let label = 'unknown offer';

                                                                const h4 = offerLink.querySelector('h4') ||
                                                                    offerLink.querySelector('.bm-cards h4') ||
                                                                    offerLink.closest('.bm-cards')?.querySelector('h4');
                                                                if (offerLink && !offerLink.closest('.activity-item')) {
                                                                    label = h4.textContent.trim();
                                                                }

                                                                // Optional: Clean up or shorten the label
                                                                label = label.toLowerCase();

                                                                pushToDataLayer(
                                                                    'e_offers',                      // event
                                                                    'user interaction',              // category
                                                                    'button click',                  // action
                                                                    label,                           // dynamic label from h4
                                                                    'en',                            // p_language
                                                                    pageTitle,                      // p_pagename
                                                                    pageCategory,               // p_pagecategory
                                                                    pageSubCategory,               // p_pagesubcategory
                                                                    previousPageTitle,
                                                                    '',
                                                                    ''
                                                                );
                                                            }
                                                            else if (formLink && formLink.textContent.trim().toLowerCase().includes('click here')) {

                                                                let label = 'unknown form';

                                                                // Get the form name from the previous <td> (left column)
                                                                const row = formLink.closest('tr');
                                                                if (row) {
                                                                    const firstTd = row.querySelector('td:first-child h4') ||
                                                                        row.querySelector('td:first-child');
                                                                    if (firstTd) {
                                                                        label = firstTd.textContent.trim();
                                                                    }
                                                                }

                                                                // Fallback: use link href filename if nothing found
                                                                if (label === 'unknown form') {
                                                                    const filename = formLink.href.split('/').pop();
                                                                    label = filename.replace('.pdf', '').replace(/_/g, ' ');
                                                                }

                                                                pushToDataLayer(
                                                                    'e_formclicks',
                                                                    'user interaction',
                                                                    'button click',
                                                                    label,
                                                                    'en',
                                                                    pageTitle,                      // p_pagename
                                                                    pageCategory,               // p_pagecategory
                                                                    pageSubCategory,               // p_pagesubcategory
                                                                    previousPageTitle,
                                                                    '',
                                                                    ''
                                                                );

                                                            }
                                                            // Trigger only when Submit button is clicked
                                                            else if (e.target.id === 'ctl00_ctl28_g_2db46d4f_b3b0_4c1d_aebe_2736a31c6087_ctl00_btnSubmit' ||
                                                                e.target.closest('input[type="submit"]')) {

                                                                const customerType = document.getElementById('ddlCustomerType');

                                                                // Only track if "bank muscat customer" is selected
                                                                if (customerType && customerType.value === '2') {

                                                                    // Get Customer Number (8 digits)
                                                                    let customerId = '';
                                                                    for (let i = 1; i <= 8; i++) {
                                                                        const field = document.getElementById(`txtACNO${i}`);
                                                                        if (field) {
                                                                            customerId += field.value.trim();
                                                                        }
                                                                    }

                                                                    // Get Feedback Type (Subject)
                                                                    const feedbackTypeSelect = document.getElementById('ddlFeedbackType');
                                                                    let subject = 'unknown';
                                                                    if (feedbackTypeSelect && feedbackTypeSelect.value !== '0') {
                                                                        subject = feedbackTypeSelect.options[feedbackTypeSelect.selectedIndex].text;
                                                                    }
                                                                    pushToDataLayer2(
                                                                        'e_formclicks',
                                                                        'en',
                                                                        pageTitle,                      // p_pagename
                                                                        pageCategory,               // p_pagecategory
                                                                        pageSubCategory,               // p_pagesubcategory
                                                                        previousPageTitle,
                                                                        customerId || 'not_provided',
                                                                        subject.toLowerCase()
                                                                    );
                                                                }
                                                            }
                                                            else if (e.target.id === 'clientSubmitBtn' || e.target.closest('#clientSubmitBtn') || e.target.id.includes('btnSubmit')) {

                                                                // Get LeadID from URL
                                                                const urlParams = new URLSearchParams(window.location.search);
                                                                var formName = $('#ctl00_ctl28_g_6a7e5fbb_f0ce_46a3_af19_eaa1fb392aca_ctl00_lblLeadTitle_DetailDesc').text().trim();
                                                                let leadId = urlParams.get('LeadID') ||
                                                                    urlParams.get('leadid') ||
                                                                    urlParams.get('id') ||
                                                                    urlParams.get('LeadId') || 'not_found';

                                                                pushToDataLayer2(
                                                                    'e_formclicks',
                                                                    'en',
                                                                    pageTitle,                      // p_pagename
                                                                    pageCategory,               // p_pagecategory
                                                                    pageSubCategory,               // p_pagesubcategory
                                                                    previousPageTitle,
                                                                    '',
                                                                    '',
                                                                    formName,
                                                                    leadId,

                                                                );
                                                            }

                                                        });
                                                        // Logo Click Event  
                                                        document.querySelectorAll('.navbar-brand').forEach(button => {
                                                            button.addEventListener('click', () => {
                                                                pushToDataLayer('e_logoclick', 'header interaction', 'button click', 'bank muscat logo', 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                            });
                                                        });

                                                        // Search Button Click Event  
                                                        // document.querySelectorAll('.ms-srch-sb').forEach(button => {
                                                        //     button.addEventListener('click', () => {
                                                        //         const searchTerm = document.querySelector('.ms-srch-sb input').value || '[keyword]';
                                                        //         pushToDataLayer('e_search', 'header interaction', 'search button', searchTerm, 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                        //     });
                                                        // });

                                                        // Branch Locator Click Event  
                                                        document.querySelectorAll('.find_us').forEach(link => {
                                                            link.addEventListener('click', () => {
                                                                pushToDataLayer('e_locator', 'footer interaction', 'link click', 'branch & atm locator', 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                            });
                                                        });

                                                        // Call Icon Click Event  
                                                        document.querySelectorAll('.social_phone').forEach(link => {
                                                            link.addEventListener('click', () => {
                                                                pushToDataLayer('e_callicon', 'footer interaction', 'phone click', '2479 5555', 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                            });
                                                        });

                                                        // Email Icon Click Event  
                                                        document.querySelectorAll('.social_mail').forEach(link => {
                                                            link.addEventListener('click', () => {
                                                                pushToDataLayer('e_emailicon', 'footer interaction', 'email click', 'care@bankmuscat.com', 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                            });
                                                        });

                                                        // Social Media Icon Click Events  
                                                        const socialIcons = [
                                                            { selector: '.social_facebook', platform: 'facebook' },
                                                            { selector: '.social_twitter', platform: 'twitter' },
                                                            { selector: '.social_linkedin', platform: 'linkedin' },
                                                            { selector: '.social_insta', platform: 'instagram' },
                                                            { selector: '.social_youtube', platform: 'youtube' }
                                                        ];

                                                        socialIcons.forEach(({ selector, platform }) => {
                                                            document.querySelectorAll(selector).forEach(link => {
                                                                link.addEventListener('click', () => {
                                                                    pushToDataLayer('e_socialicon', 'footer interaction', 'social media click', platform, 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                                });
                                                            });
                                                        });

                                                        // Additional Existing Event Listeners (from your previous implementation)  
                                                        // Header Carousel Click Event  
                                                        // document.querySelectorAll('.hwslider').forEach(button => {
                                                        //     button.addEventListener('click', () => {
                                                        //         const bannerName = document.querySelector('.hwslider .active h2')?.textContent || 'discover world beyond banking';
                                                        //         pushToDataLayer('e_pageheadercarousel', 'header interaction', 'carousel click', bannerName, 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                        //     });
                                                        // });

                                                        // Page Body Carousel Click Event  
                                                        document.querySelectorAll('.sy-controls').forEach(button => {
                                                            button.addEventListener('click', () => {
                                                                const bannerName = document.querySelector('.sy-active .banner-title')?.textContent || 'connect with us';
                                                                pushToDataLayer('e_pagebodycarousel', 'page body interaction', 'carousel click', bannerName, 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                            });
                                                        });

                                                        // Page Body CTA Click Event  
                                                        // document.querySelectorAll('.activity-item').forEach(button => {
                                                        //     button.addEventListener('click', () => {
                                                        //         const ctaText = button.querySelector('h3')?.textContent || 'choose your card';
                                                        //         pushToDataLayer('e_pagebodycta', 'page body interaction', 'cta icons', ctaText, 'en', pageTitle, pageCategory, pageSubCategory, previousPageTitle, '', '');
                                                        //     });
                                                        // });
                                                    }

                                                    // Initialize Event Listeners  
                                                    addEventListenersToButtons();
                                                };  
                                            </script>



                                        </head>


