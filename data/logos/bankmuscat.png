                                                            var footerCategory = $($(this).parents()[2]).find('a')[0].text;
                                                            var footerSegment = $($(this).parents()[4]).find('a')[0].text;

                                                            PushDataGA('footerinteraction', footerLink, footerSegment, footerCategory, footerSubCategory);

                                                            location.href = e.currentTarget.href;
                                                        });


                                                        $('.footer-parent > ul > li > a').click(function (e) {
                                                            //debugger; 

                                                            e.preventDefault();

                                                            var footerLink = $(this)[0].href;
                                                            var footerSubCategory = '';
                                                            var footerCategory = $(this)[0].text;
                                                            var footerSegment = $($(this).parents()[2]).find('a')[0].text;

                                                            PushDataGA('footerinteraction', footerLink, footerSegment, footerCategory, footerSubCategory);

                                                            location.href = e.currentTarget.href;

                                                        });

                                                        $('#cssmenu > ul > li > a').click(function (e) {
                                                            //debugger; 
                                                            e.preventDefault();

                                                            var footerLink = $(this)[0].href;
                                                            var footerSubCategory = '';
                                                            var footerCategory = '';
                                                            var footerSegment = $(this)[0].text;

                                                            PushDataGA('footerinteraction', footerLink, footerSegment, footerCategory, footerSubCategory);

                                                            location.href = e.currentTarget.href;


                                                        });

                                                        $('.sy-box a').click(function () {

                                                            var link = $(this)[0].href;
                                                            var buttonName = 'Home Box Slider - ' + $($(this)[0]).find('img').attr('src');
                                                            PushDataGA('pagebodyinteraction', link, segment, category, subcategory, buttonName);

                                                        });

                                                        $('.boxes-height a').click(function () {

                                                            var link = $(this)[0].href;
                                                            var buttonName = 'Home Box Icon - ' + $($(this)[0]).find('img').attr('src');
                                                            PushDataGA('pagebodyinteraction', link, segment, category, subcategory, buttonName);

                                                        });

                                                        $('.hwslider a').click(function () {

                                                            var link = $(this)[0].href;
                                                            var buttonName = 'Home Main Slider - ' + $($(this)[0]).find('img').attr('src');
                                                            PushDataGA('pagebodyinteraction', link, segment, category, subcategory, buttonName);

                                                        });

                                                        $('.promo-btn').click(function () {

                                                            var link = $(this)[0].href;
                                                            var buttonName = $($($(this)[0]).closest('section')[0]).find('h1')[0].innerText + " - " + $(this)[0].innerText;

                                                            PushDataGA('pagebodyinteraction', link, segment, category, subcategory, buttonName);

                                                        });

                                                        $('#footer_social > a').click(function () {

                                                            var link = $(this)[0].href;
                                                            var ribbonElement = $(this)[0].className.replace('bmtooltip', '').trim();

                                                            PushDataGAFooter('FooterRibbonClicks', link, segment, category, subcategory, ribbonElement);

                                                        });




                                                    }, 1000);


                                                });



                                                function PushDataGA(event, clickedUrl, segment, category, subCategory, buttonName) {

                                                    if (buttonName == null) {
                                                        buttonName = '';
                                                    }

                                                    //  Get current page 
                                                    var currentPageUrl = "";
                                                    if (typeof this.href === "undefined") {
                                                        currentPageUrl = document.location.toString().toLowerCase();
                                                    }
                                                    else {
                                                        currentPageUrl = this.href.toString().toLowerCase();
                                                    }
                                                    var sliteddata = currentPageUrl.split("/");

                                                    var dataLayer = window.dataLayer || [];
                                                    dataLayer.push({
                                                        'event': event,
                                                        'language': sliteddata[3],
                                                        'segment': segment,
                                                        'category': category,
                                                        'subCategory': subCategory,
                                                        'loginStatus': '',
                                                        'customerID': '',
                                                        'buttonname': buttonName,
                                                        'clickUrl': clickedUrl
                                                    });
                                                }


                                                function PushDataGAFooter(event, clickedUrl, segment, category, subCategory, ribbonElem) {

                                                    if (ribbonElem == null) {
                                                        ribbonElem = '';
                                                    }

                                                    //  Get current page 
                                                    var currentPageUrl = "";
                                                    if (typeof this.href === "undefined") {
                                                        currentPageUrl = document.location.toString().toLowerCase();
                                                    }
                                                    else {
                                                        currentPageUrl = this.href.toString().toLowerCase();
                                                    }
                                                    var sliteddata = currentPageUrl.split("/");

                                                    var dataLayer = window.dataLayer || [];
                                                    dataLayer.push({
                                                        'event': event,
                                                        'language': sliteddata[3],
                                                        'segment': segment,
                                                        'category': category,
                                                        'subCategory': subCategory,
                                                        'loginStatus': '',
                                                        'customerID': '',
                                                        'ribbonElement': ribbonElem
                                                    });
                                                }



                                                //]]></script>




